{
  "name": "@otto/native",
  "version": "0.1.0",
  "description": "Rust native bindings for Otto - Session store, encryption, tokenizer, agent pool",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node dist/test.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/**/*",
    "bin/**/*"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
