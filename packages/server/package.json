{
  "name": "otto-server",
  "version": "0.1.0",
  "description": "Otto - local app server (single source of session truth, HTTP/WS, Feishu bridge)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "otto-server": "dist/bin.js",
    "otto-database-encryption": "dist/src/modules/data_platform/databaseEncryptionCli.js",
    "otto-enterprise-postgres": "dist/src/modules/data_platform/postgresDatabaseCli.js"
  },
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "start": "node dist/bin.js start",
    "enterprise": "node dist/src/enterprise/bin.js",
    "enterprise:seed": "node dist/src/enterprise/bin.js --seed",
    "enterprise:postgres:prepare": "node dist/src/modules/data_platform/postgresDatabaseCli.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@google/genai": "1.35.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "better-sqlite3": "12.11.1",
    "otto-core": "file:../core",
    "pg": "8.22.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "8.11.0",
    "@types/ws": "^8.5.12",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
