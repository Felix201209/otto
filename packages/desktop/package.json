{
  "name": "otto-desktop",
  "version": "1.9.11",
  "description": "Otto Desktop - Electron app shell (main + preload + renderer reusing webview DOM UI)",
  "author": "Otto",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json --noEmit && webpack-cli --config webpack.preload.cjs --mode production && node scripts/verify-preload-bundle.mjs",
    "build:renderer": "webpack-cli --config webpack.config.cjs --mode production",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dev:renderer": "webpack-cli --config webpack.config.cjs --mode development --watch",
    "start": "electron .",
    "runtime:verify:mac": "node scripts/verify-document-runtime.mjs --target darwin-arm64 --target darwin-x64",
    "runtime:verify:win": "node scripts/verify-document-runtime.mjs --target win32-x64",
    "dist": "npm run build && electron-builder --mac --dir",
    "dist:dmg": "npm run build && electron-builder --mac dmg --arm64",
    "dist:dmg:x64": "npm run build && electron-builder --mac dmg --x64",
    "dist:win": "node scripts/fetch-win-ripgrep.mjs && npm run build && electron-builder --win --x64 --publish never && node scripts/verify-packaged-runtime.mjs release/win-unpacked/resources/app.asar --platform win32",
    "package": "node scripts/make-delivery-zip.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist:all": "npm run build && electron-builder --mac dmg --arm64 --x64 && electron-builder --win --x64",
    "release": "node scripts/make-delivery-zip.mjs --build",
    "release:gate": "node scripts/release-recovery-gate.mjs",
    "dist:green": "npm run build && electron-builder --mac --dir \"--config.productName=Otto Green\" --config.appId=ai.otto.green.desktop --config.protocols[0].schemes[0]=otto-green --config.mac.artifactName=OttoGreen-${version}-${arch}.${ext} \"--config.nsis.shortcutName=Otto Green\" --config.extraMetadata.name=otto-green-desktop",
    "dist:green:win": "node scripts/fetch-win-ripgrep.mjs && npm run build && electron-builder --win --x64 --publish never \"--config.productName=Otto Green\" --config.appId=ai.otto.green.desktop --config.protocols[0].schemes[0]=otto-green --config.win.artifactName=OttoGreen-Setup-${version}-win-x64.${ext} --config.nsis.artifactName=OttoGreen-Setup-${version}-win-x64.${ext} \"--config.nsis.shortcutName=Otto Green\" --config.extraMetadata.name=otto-green-desktop"
  },
  "dependencies": {
    "otto-server": "file:../server",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.19.9",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "css-loader": "^7.1.2",
    "electron": "^43.1.0",
    "electron-builder": "26.15.3",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^26.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "ws": "^8.21.1"
  },
  "build": {
    "publish": [
      {
        "provider": "generic",
        "url": "https://59.110.154.44:7777/downloads"
      }
    ],
    "appId": "ai.otto.desktop",
    "productName": "Otto",
    "copyright": "Copyright © 2025 Otto",
    "protocols": [
      {
        "name": "Otto 企业邀请",
        "schemes": [
          "otto"
        ]
      }
    ],
    "electronVersion": "43.1.0",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/*.markdown",
      "!**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/**/test/**",
      "!**/node_modules/**/tests/**",
      "!**/node_modules/**/__tests__/**",
      "!**/node_modules/**/docs/**",
      "!**/node_modules/**/doc/**",
      "!**/node_modules/**/examples/**",
      "!**/node_modules/**/example/**",
      "!**/node_modules/@vscode/ripgrep/**",
      "!**/node_modules/@larksuiteoapi/node-sdk/es/**",
      "!**/node_modules/@larksuiteoapi/node-sdk/types/**",
      "!**/node_modules/js-tiktoken/dist/**/*.cjs",
      "!**/coverage/**",
      "!**/junit.xml",
      "!**/*.tsbuildinfo",
      "!**/*.test.*",
      "!**/__tests__/**"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "artifactName": "Otto-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": true,
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Otto 使用麦克风将语音转换为聊天输入文字。"
      },
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "app-icon.png"
        },
        {
          "from": "../../node_modules/@vscode/ripgrep/bin/rg",
          "to": "ripgrep/rg"
        }
      ]
    },
    "dmg": {
      "sign": true,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "app-icon.png"
        },
        {
          "from": "vendor/win/ripgrep/rg.exe",
          "to": "ripgrep/rg.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Otto",
      "artifactName": "Otto-Setup-${version}-win-x64.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
