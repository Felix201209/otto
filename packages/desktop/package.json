{
  "name": "otto-desktop",
  "version": "1.8.7",
  "description": "Otto Desktop - Electron app shell (main + preload + renderer reusing webview DOM UI)",
  "author": "Otto",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "webpack-cli --config webpack.config.cjs --mode production",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dev:renderer": "webpack-cli --config webpack.config.cjs --mode development --watch",
    "start": "electron .",
    "dist": "npm run build && electron-builder --mac --dir",
    "dist:dmg": "npm run build && electron-builder --mac dmg --arm64 --x64",
    "dist:win": "node scripts/fetch-win-ripgrep.mjs && npm run build && electron-builder --win --x64",
    "package": "node scripts/make-delivery-zip.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist:all": "npm run build && electron-builder --mac dmg --arm64 --x64 && electron-builder --win --x64",
    "release": "node scripts/make-delivery-zip.mjs --build"
  },
  "dependencies": {
    "otto-server": "file:../server",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.19.9",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "css-loader": "^7.1.2",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^26.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "ai.otto.desktop",
    "productName": "Otto",
    "copyright": "Copyright © 2025 Otto",
    "protocols": [
      {
        "name": "Otto 企业邀请",
        "schemes": ["otto"]
      }
    ],
    "electronVersion": "43.1.0",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/coverage/**",
      "!**/junit.xml",
      "!**/*.tsbuildinfo",
      "!**/*.test.*",
      "!**/__tests__/**"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "includeSubNodeModules": true,
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "artifactName": "Otto-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Otto 使用麦克风将语音转换为聊天输入文字。"
      },
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "../../node_modules/@vscode/ripgrep/bin/rg",
          "to": "ripgrep/rg"
        },
        {
          "from": "../../resources/video-editor",
          "to": "video-editor"
        }
      ]
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "vendor/win/ripgrep/rg.exe",
          "to": "ripgrep/rg.exe"
        },
        {
          "from": "../../resources/video-editor",
          "to": "video-editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Otto",
      "artifactName": "Otto-Setup-${version}-win-x64.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
