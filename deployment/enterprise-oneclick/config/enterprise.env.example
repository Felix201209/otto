# 必填：解析到新服务器公网 IP 的域名。托管 Caddy 模式不接受裸 IP。
OTTO_PUBLIC_HOST=enterprise.example.com
OTTO_PUBLIC_PORT=7777

# managed：安装并配置 Caddy；external：只启动 127.0.0.1:7778，由你自己的代理接管。
OTTO_CADDY_MODE=managed

# auto 会生成 32-byte 随机平台令牌并仅写入 root:root 0600 的运行配置。
OTTO_ENTERPRISE_ADMIN_TOKEN=auto

# 迁移库已有账号时不会新建管理员；全新空库时 auto 会生成一次性密码。
OTTO_BOOTSTRAP_USERNAME=admin
OTTO_BOOTSTRAP_PASSWORD=auto
OTTO_BOOTSTRAP_NAME=系统管理员

# 邀请码短信注册所需。默认 fail closed：四项不全则拒绝安装。
ALIYUN_SMS_PROVIDER=pnvs
ALIYUN_SMS_ACCESS_KEY_ID=REPLACE_ME
ALIYUN_SMS_ACCESS_KEY_SECRET=REPLACE_ME
ALIYUN_SMS_SIGN_NAME=REPLACE_ME
ALIYUN_SMS_TEMPLATE_ID=REPLACE_ME

# 可选：园区报修的短信通知模板。留空时仍会保存报修，但不会发短信通知。
ALIYUN_SMS_NOTIFICATION_TEMPLATE_ID=

# 可选：园区报修的飞书/Lark 通知。APP_ID 与 APP_SECRET 必须同时填写。
# DOMAIN 可填 feishu 或 lark；留空时默认使用飞书中国站。
OTTO_ENTERPRISE_FEISHU_APP_ID=
OTTO_ENTERPRISE_FEISHU_APP_SECRET=
OTTO_ENTERPRISE_FEISHU_DOMAIN=feishu

# 仅做不含短信注册的临时隔离测试时才设为 1；正式迁移请保持 0。
OTTO_ALLOW_SMS_DISABLED=0

# 可选业务参数。
OTTO_DEFAULT_ORGANIZATION_NAME=Otto 企业
OTTO_ENTERPRISE_USAGE_DAILY_LIMIT=10000
OTTO_CREDIT_TOKEN_RATE=1000000
OTTO_ESTIMATE_MANUAL_MULT=2
OTTO_ESTIMATE_CNY_PER_HOUR=50
OTTO_ESTIMATE_LABOR_PER_TOKEN_CAP=50

# 数据保护：密钥只用于备份归档，正式部署后请离线托管一份。auto 会安全生成。
OTTO_BACKUP_ENCRYPTION_KEY=auto
OTTO_BACKUP_INTERVAL_HOURS=24
OTTO_BACKUP_RETENTION_DAYS=30
OTTO_BACKUP_MINIMUM_RETAINED=3
OTTO_DISK_MIN_FREE_MB=2048

# 可选：把远端/NFS/对象存储网关挂载到该固定路径后开启异地副本。
OTTO_BACKUP_REPLICA_DIR=

# 可选：我方运行与用量遥测接收地址。只允许 HTTPS；聊天、文件和会议内容默认不上报，可在管理员页一键关闭。
OTTO_TELEMETRY_ENDPOINT=
OTTO_TELEMETRY_RETENTION_DAYS=90

# 数据治理：正式交付前应填写客户侧个人信息处理者及有效联系方式。
OTTO_DATA_CONTROLLER_NAME=示例企业有限公司
OTTO_PRIVACY_CONTACT=privacy@example.com
OTTO_DATA_REGION=CN
OTTO_DATA_RESIDENCY=customer_server
# 默认关闭。开启前应完成个人信息保护影响评估、单独同意及适用的数据出境程序。
OTTO_CROSS_BORDER_DATA_ENABLED=false
